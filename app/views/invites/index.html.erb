<div class="max-w-2xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-display font-bold text-hoot-950">Invite Friends</h1>
      <p class="text-slate-500 text-sm mt-1">Share a link to connect with friends</p>
    </div>
    <%= button_to invites_path, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-hoot-500 hover:bg-hoot-600 text-white font-semibold rounded-full shadow-lg shadow-hoot-500/25 transition-all duration-200 cursor-pointer" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New Invite Link
    <% end %>
  </div>

  <div id="invites-list" class="space-y-3">
    <% if @invites.empty? %>
      <div id="empty-invites" class="text-center py-16">
        <span class="text-5xl block mb-4">🔗</span>
        <p class="text-slate-400">No invite links yet. Create one to share with friends!</p>
      </div>
    <% end %>

    <% @invites.each do |invite| %>
      <%= render "invites/invite", invite: invite %>
    <% end %>
  </div>
</div>
