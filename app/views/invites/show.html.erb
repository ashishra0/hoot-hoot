<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-hoot-50 via-white to-hoot-100">
  <div class="w-full max-w-md animate-fade-in-up">
    <div class="text-center mb-8">
      <span class="text-5xl block mb-4">🦉</span>
      <h1 class="text-3xl font-display font-bold text-hoot-950">Friend Request</h1>
    </div>

    <div class="bg-white rounded-2xl shadow-xl shadow-hoot-500/5 border border-surface-200 p-8 text-center">
      <% if @already_friends %>
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-50 mb-4">
            <svg class="w-8 h-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <p class="text-lg font-semibold text-slate-800">You're already friends with @<%= @inviter.username %>!</p>
        </div>
        <a href="<%= dashboard_path %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-hoot-500 hover:bg-hoot-600 text-white font-semibold rounded-full transition-all">
          Go to Dashboard
        </a>
      <% else %>
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-hoot-100 mb-4">
            <span class="text-3xl">🦉</span>
          </div>
          <p class="text-lg font-semibold text-slate-800 mb-1">
            @<%= @inviter.username %> wants to be your friend!
          </p>
          <% if @inviter.display_name.present? %>
            <p class="text-sm text-slate-500"><%= @inviter.display_name %></p>
          <% end %>
        </div>

        <%= button_to claim_invite_path(token: @invite.token),
            class: "inline-flex items-center gap-2 px-8 py-3 bg-hoot-500 hover:bg-hoot-600 text-white font-semibold rounded-full shadow-lg shadow-hoot-500/25 transition-all duration-200 cursor-pointer" do %>
          Accept & Start Hooting
        <% end %>
      <% end %>
    </div>
  </div>
</div>
