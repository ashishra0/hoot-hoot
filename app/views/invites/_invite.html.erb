<div class="bg-white rounded-xl border border-surface-200 p-4 flex items-center justify-between gap-4">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <% if invite.claimed? %>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-green-50 text-green-600 text-xs font-medium rounded-full">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Claimed by @<%= invite.claimed_by.username %>
        </span>
      <% elsif invite.expired? %>
        <span class="inline-flex items-center px-2 py-0.5 bg-slate-100 text-slate-400 text-xs font-medium rounded-full">
          Expired
        </span>
      <% else %>
        <span class="inline-flex items-center px-2 py-0.5 bg-hoot-50 text-hoot-600 text-xs font-medium rounded-full">
          Active
        </span>
      <% end %>
    </div>
    <code class="text-sm text-slate-500 truncate block"><%= invite_url(token: invite.token) %></code>
  </div>

  <% unless invite.claimed? || invite.expired? %>
    <button
      data-controller="clipboard"
      data-clipboard-text-value="<%= invite_url(token: invite.token) %>"
      data-action="click->clipboard#copy"
      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-hoot-600 bg-hoot-50 hover:bg-hoot-100 rounded-lg transition-colors shrink-0 cursor-pointer"
    >
      <svg class="w-4 h-4" data-clipboard-target="icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
      </svg>
      <span data-clipboard-target="label">Copy</span>
    </button>
  <% end %>
</div>
