<div class="pointer-events-auto" data-controller="toast" data-toast-sound-value="/sounds/hoot.wav">
  <a href="<%= dashboard_path(friendship_id: hoot.friendship_id) %>"
     data-turbo-action="replace"
     class="flex items-center gap-3 bg-white border border-hoot-200 rounded-xl pl-5 pr-2 py-3.5 shadow-xl shadow-hoot-500/10 animate-slide-in min-w-[280px]">
    <div class="shrink-0 w-10 h-10 rounded-full bg-gradient-to-br from-hoot-400 to-hoot-600 flex items-center justify-center">
      <span class="text-xl leading-none">🦉</span>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-slate-800 text-sm"><%= hoot.sender.display_name || hoot.sender.username %></p>
      <p class="text-xs text-hoot-500 font-medium">hooted at you!</p>
    </div>
    <button type="button"
            data-action="click->toast#dismiss"
            class="shrink-0 p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </a>
</div>
