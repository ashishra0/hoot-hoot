<%# Update streak counter %>
<%= turbo_stream.replace "streak-display" do %>
  <div id="streak-display" class="flex flex-col items-center pt-8">
    <div class="flex items-center gap-3">
      <% if @friendship.current_streak > 0 %>
        <span class="text-4xl"><%= streak_emoji(@friendship.current_streak) %></span>
        <span class="text-6xl font-display font-bold text-white drop-shadow-lg"><%= @friendship.current_streak %></span>
      <% else %>
        <span class="text-4xl opacity-50">🦉</span>
        <span class="text-5xl font-display font-bold text-white/50">0</span>
      <% end %>
    </div>

    <% if @friendship.longest_streak > 0 && @friendship.longest_streak != @friendship.current_streak %>
      <p class="text-sm text-white/40 mt-1">best: <%= @friendship.longest_streak %></p>
    <% end %>
  </div>
<% end %>

<%# Update status text %>
<%= turbo_stream.replace "status-text" do %>
  <div id="status-text" class="text-center">
    <p class="text-xl font-display font-medium text-white/90">
      <%= owl_status_message(@owl_mood, @partner.display_name || @partner.username) %>
    </p>
    <p class="text-sm text-white/50 mt-1">with @<%= @partner.username %></p>
  </div>
<% end %>

<%# Update owl mood %>
<%= turbo_stream.replace "owl-area" do %>
  <div id="owl-area" class="flex-1 flex items-center justify-center">
    <%= render "shared/owl", mood: @owl_mood %>
  </div>
<% end %>

<%# Update friend switcher to refresh attention indicators %>
<% friendships = current_user.friendships.includes(:user, :friend).order(updated_at: :desc) %>
<% if friendships.size > 1 %>
  <%= turbo_stream.replace "friend-switcher" do %>
    <%= render "dashboard/friend_switcher",
               friendships: friendships,
               active_friendship: @friendship,
               current_user: current_user %>
  <% end %>
<% end %>
