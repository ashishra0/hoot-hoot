<div class="max-w-lg mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-display font-bold text-slate-800">Friends</h1>
    <a href="<%= invites_path %>"
       class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-white bg-hoot-500 hover:bg-hoot-600 rounded-full transition-colors shadow-md">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Add Friend
    </a>
  </div>

  <% if @friendships.any? %>
    <div class="space-y-3">
      <% @friendships.each do |fs| %>
        <% partner = fs.partner_of(current_user) %>
        <% i_hooted = fs.hooted_today?(current_user) %>
        <% they_hooted = fs.hooted_today?(partner) %>
        <% needs_attention = they_hooted && !i_hooted %>

        <a href="<%= dashboard_path(friendship_id: fs.id) %>"
           class="group flex items-center gap-4 p-4 bg-white rounded-2xl border border-surface-200 hover:border-hoot-300 hover:shadow-lg transition-all duration-200">

          <%# Avatar %>
          <div class="relative shrink-0">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-hoot-400 to-hoot-600 flex items-center justify-center">
              <span class="text-xl text-white font-bold"><%= (partner.display_name || partner.username)[0].upcase %></span>
            </div>
            <% if needs_attention %>
              <span class="absolute -top-0.5 -right-0.5 flex h-3.5 w-3.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-amber-400 border-2 border-white"></span>
              </span>
            <% end %>
          </div>

          <%# Info %>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="font-semibold text-slate-800 truncate"><%= partner.display_name || partner.username %></p>
              <% if needs_attention %>
                <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">Hoot back!</span>
              <% end %>
            </div>
            <p class="text-sm text-slate-500 mt-0.5">@<%= partner.username %></p>
          </div>

          <%# Streak + Status %>
          <div class="shrink-0 text-right">
            <% if fs.current_streak > 0 %>
              <div class="flex items-center gap-1 justify-end">
                <span class="text-lg"><%= streak_emoji(fs.current_streak) %></span>
                <span class="text-lg font-bold text-slate-800"><%= fs.current_streak %></span>
              </div>
            <% end %>
            <div class="flex items-center gap-1 mt-1 justify-end">
              <% if i_hooted && they_hooted %>
                <span class="inline-flex items-center gap-1 text-xs text-green-600 font-medium">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  Done
                </span>
              <% elsif i_hooted %>
                <span class="text-xs text-hoot-500 font-medium">Waiting...</span>
              <% elsif they_hooted %>
                <span class="text-xs text-amber-600 font-medium">Your turn!</span>
              <% else %>
                <span class="text-xs text-slate-400">Tap to hoot</span>
              <% end %>
            </div>
          </div>

          <%# Chevron %>
          <svg class="w-5 h-5 text-slate-300 group-hover:text-hoot-500 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div class="text-5xl mb-4">🦉</div>
      <h2 class="text-lg font-display font-semibold text-slate-700 mb-2">No friends yet</h2>
      <p class="text-slate-500 mb-6 max-w-xs mx-auto">Send an invite link to start hooting with your friends!</p>
      <a href="<%= invites_path %>"
         class="inline-flex items-center gap-2 px-6 py-3 bg-hoot-500 text-white font-semibold rounded-full hover:bg-hoot-600 transition-colors shadow-md">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.243a4.5 4.5 0 00-6.364-6.364L4.5 8.688a4.5 4.5 0 001.242 7.244" />
        </svg>
        Create Invite Link
      </a>
    </div>
  <% end %>
</div>
