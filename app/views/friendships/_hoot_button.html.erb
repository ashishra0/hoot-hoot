<div id="hoot-btn-<%= friendship.id %>" class="flex flex-col items-center gap-1.5">
  <%= form_with url: hoots_path, class: "inline" do |f| %>
    <%= f.hidden_field :friendship_id, value: friendship.id %>
    <button
      type="submit"
      data-controller="hoot-button"
      data-action="click->hoot-button#hoot"
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-hoot-500 hover:bg-hoot-600 text-white rounded-full font-semibold text-sm shadow-lg shadow-hoot-500/25 hover:shadow-xl transition-all duration-200 cursor-pointer"
    >
      <span class="text-lg leading-none">🦉</span>
      <span>HOOT</span>
    </button>
  <% end %>

  <% if already_hooted %>
    <span class="inline-flex items-center gap-1 text-xs text-green-500 font-medium">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      Streak secured
    </span>
  <% end %>
</div>
