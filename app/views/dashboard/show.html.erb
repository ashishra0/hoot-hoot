<% content_for :transparent_navbar, "true" %>
<%= turbo_stream_from "user_#{current_user.id}_hoots" %>

<% if @friendship %>
  <div id="dashboard-content" class="fixed inset-0 bg-gradient-to-b from-hoot-500 via-hoot-600 to-hoot-700 flex flex-col items-center justify-between overflow-hidden" style="padding-top: 4.5rem;">
    <!-- Streak Counter -->
    <div id="streak-display" class="flex flex-col items-center pt-8 animate-fade-in">
      <div class="flex items-center gap-3">
        <% if @friendship.current_streak > 0 %>
          <span class="text-4xl"><%= streak_emoji(@friendship.current_streak) %></span>
          <span class="text-6xl font-display font-bold text-white drop-shadow-lg"><%= @friendship.current_streak %></span>
        <% else %>
          <span class="text-4xl opacity-50">🦉</span>
          <span class="text-5xl font-display font-bold text-white/50">0</span>
        <% end %>
      </div>

      <% if @friendship.longest_streak > 0 && @friendship.longest_streak != @friendship.current_streak %>
        <p class="text-sm text-white/40 mt-1">best: <%= @friendship.longest_streak %></p>
      <% end %>
    </div>

    <!-- Status Text -->
    <div id="status-text" class="text-center animate-fade-in">
      <p class="text-xl font-display font-medium text-white/90">
        <%= owl_status_message(@owl_mood, @partner.display_name || @partner.username) %>
      </p>
      <p class="text-sm text-white/50 mt-1">with @<%= @partner.username %></p>
    </div>

    <!-- Owl (clickable = hoot) -->
    <div id="owl-area" class="flex-1 flex items-center justify-center animate-fade-in-up">
      <%= render "shared/owl", mood: @owl_mood %>
    </div>

    <!-- Hidden hoot form -->
    <%= form_with url: hoots_path, id: "hoot-form", class: "hidden" do |f| %>
      <%= f.hidden_field :friendship_id, value: @friendship.id %>
    <% end %>

    <!-- Bottom hint -->
    <div class="pb-8 text-center animate-fade-in">
      <p class="text-sm text-white/40 font-medium">Tap the owl to hoot</p>
    </div>
  </div>

<% else %>
  <!-- No partner yet -->
  <div class="min-h-screen bg-gradient-to-b from-hoot-500 via-hoot-600 to-hoot-700 flex flex-col items-center justify-center px-4" style="padding-top: 4.5rem;">
    <div class="text-center animate-fade-in-up">
      <div class="mb-6">
        <%= render "shared/owl", mood: :sleepy %>
      </div>
      <h2 class="text-2xl font-display font-bold text-white mb-2">No partner yet</h2>
      <p class="text-white/60 mb-8 max-w-sm">Share an invite link with your person to start hooting together!</p>
      <a href="<%= invites_path %>" class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-hoot-600 font-semibold rounded-full shadow-xl hover:shadow-2xl transition-all duration-200">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.243a4.5 4.5 0 00-6.364-6.364L4.5 8.688a4.5 4.5 0 001.242 7.244" />
        </svg>
        Create Invite Link
      </a>
    </div>
  </div>
<% end %>
