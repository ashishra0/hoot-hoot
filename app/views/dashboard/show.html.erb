<%= turbo_stream_from "user_#{current_user.id}_hoots" %>

<div class="max-w-2xl mx-auto px-4 py-10">
  <!-- Greeting -->
  <div class="mb-8">
    <h1 class="text-2xl font-display font-bold text-hoot-950">
      Hey, <%= current_user.display_name || current_user.username %>!
    </h1>
    <p class="text-slate-500 text-sm mt-1">Here are your friends and streaks</p>
  </div>

  <!-- Friend Cards -->
  <div id="friendships-list" class="space-y-4">
    <% if @friendships.empty? %>
      <div id="empty-friends" class="text-center py-20">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-hoot-100 mb-6">
          <span class="text-4xl">🦉</span>
        </div>
        <h2 class="text-xl font-display font-semibold text-slate-700 mb-2">No friends yet</h2>
        <p class="text-slate-400 mb-6 max-w-sm mx-auto">Share an invite link with someone to get started. You'll be hooting in no time!</p>
        <a href="<%= invites_path %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-hoot-500 hover:bg-hoot-600 text-white font-semibold rounded-full shadow-lg shadow-hoot-500/25 transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-9 1.5a3.75 3.75 0 117.5 0v.75M6 21h12a2.25 2.25 0 002.25-2.25V15A2.25 2.25 0 0018 12.75H6A2.25 2.25 0 003.75 15v3.75A2.25 2.25 0 006 21z" />
          </svg>
          Invite a Friend
        </a>
      </div>
    <% else %>
      <% @friendships.each do |friendship| %>
        <%= render "friendships/card", friendship: friendship, current_user: current_user %>
      <% end %>
    <% end %>
  </div>
</div>
