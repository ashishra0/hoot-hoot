<% transparent = local_assigns.fetch(:transparent, false) %>

<% if transparent %>
  <nav class="bg-white/10 backdrop-blur-md border-b border-white/10 fixed top-0 left-0 right-0 z-40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2 group">
          <span class="text-2xl transition-transform group-hover:rotate-12">🦉</span>
          <span class="text-xl font-display font-bold text-white">HootHoot</span>
        </a>
        <div class="flex items-center gap-3">
          <a href="<%= invites_path %>" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white/80 bg-white/10 hover:bg-white/20 rounded-full transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.243a4.5 4.5 0 00-6.364-6.364L4.5 8.688a4.5 4.5 0 001.242 7.244" />
            </svg>
            Invite
          </a>
          <div class="flex items-center gap-2 pl-3 border-l border-white/20">
            <span class="text-sm font-medium text-white/60">@<%= current_user.username %></span>
            <%= button_to "Log out", logout_path, method: :delete,
                class: "text-sm text-white/40 hover:text-white/70 transition-colors" %>
          </div>
        </div>
      </div>
    </div>
  </nav>
<% else %>
  <nav class="bg-white/80 backdrop-blur-lg border-b border-hoot-100 sticky top-0 z-40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <a href="<%= dashboard_path %>" class="flex items-center gap-2 group">
          <span class="text-2xl transition-transform group-hover:rotate-12">🦉</span>
          <span class="text-xl font-display font-bold bg-gradient-to-r from-hoot-600 to-hoot-500 bg-clip-text text-transparent">HootHoot</span>
        </a>
        <div class="flex items-center gap-3">
          <a href="<%= invites_path %>" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-hoot-600 bg-hoot-50 hover:bg-hoot-100 rounded-full transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.243a4.5 4.5 0 00-6.364-6.364L4.5 8.688a4.5 4.5 0 001.242 7.244" />
            </svg>
            Invite
          </a>
          <div class="flex items-center gap-2 pl-3 border-l border-surface-200">
            <span class="text-sm font-medium text-slate-600">@<%= current_user.username %></span>
            <%= button_to "Log out", logout_path, method: :delete,
                class: "text-sm text-slate-400 hover:text-slate-600 transition-colors" %>
          </div>
        </div>
      </div>
    </div>
  </nav>
<% end %>
