<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-hoot-50 via-white to-hoot-100">
  <div class="w-full max-w-md animate-fade-in-up">
    <!-- Header -->
    <div class="text-center mb-8">
      <a href="<%= root_path %>" class="inline-block mb-4">
        <span class="text-5xl">🦉</span>
      </a>
      <h1 class="text-3xl font-display font-bold text-hoot-950">Join HootHoot</h1>
      <p class="text-slate-500 mt-1">Create your account and start hooting</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-hoot-500/5 border border-surface-200 p-8">
      <%= form_with model: @user, url: signup_path, class: "space-y-5" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <ul class="text-sm text-red-600 space-y-1">
              <% @user.errors.full_messages.each do |msg| %>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                  </svg>
                  <%= msg %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-4 py-2.5 rounded-xl border border-surface-200 bg-surface-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-hoot-500/30 focus:border-hoot-400 transition-all" %>
        </div>

        <div>
          <%= f.label :username, class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.text_field :username, required: true, autocomplete: "username",
              placeholder: "coolowl42",
              class: "w-full px-4 py-2.5 rounded-xl border border-surface-200 bg-surface-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-hoot-500/30 focus:border-hoot-400 transition-all" %>
          <p class="text-xs text-slate-400 mt-1">3-20 characters. Letters, numbers, underscores.</p>
        </div>

        <div>
          <%= f.label :display_name, "Display name (optional)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.text_field :display_name, autocomplete: "name",
              placeholder: "Your name",
              class: "w-full px-4 py-2.5 rounded-xl border border-surface-200 bg-surface-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-hoot-500/30 focus:border-hoot-400 transition-all" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password",
              placeholder: "At least 6 characters",
              class: "w-full px-4 py-2.5 rounded-xl border border-surface-200 bg-surface-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-hoot-500/30 focus:border-hoot-400 transition-all" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
              placeholder: "Type it again",
              class: "w-full px-4 py-2.5 rounded-xl border border-surface-200 bg-surface-50 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-hoot-500/30 focus:border-hoot-400 transition-all" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Create Account",
              class: "w-full py-3 bg-hoot-500 hover:bg-hoot-600 text-white font-semibold rounded-xl shadow-lg shadow-hoot-500/25 hover:shadow-xl hover:shadow-hoot-500/30 transition-all duration-200 cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Footer link -->
    <p class="text-center text-sm text-slate-500 mt-6">
      Already have an account?
      <a href="<%= login_path %>" class="text-hoot-600 hover:text-hoot-700 font-medium">Log in</a>
    </p>
  </div>
</div>
